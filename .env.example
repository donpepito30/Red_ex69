# GEMINI_API_KEY: Required for Gemini AI chat interactions with models.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# AFFILIATE_ID: Default affiliate ID for live stream embeds and links (optional)
AFFILIATE_ID=

# ALLOWED_ORIGIN: Required to restrict API access to your domain (e.g., https://misitio.com). Use * to allow all (not recommended).
ALLOWED_ORIGIN=*

# SECRET_TOKEN: Optional secret for internal/administrative routes.
SECRET_TOKEN=

